# Banco de dados (Prisma/Postgres). Localmente, aponte para um Postgres seu;
# em produção (Vercel), use a connection string da sua Neon/Supabase/Vercel Postgres.
DATABASE_URL="postgresql://user:password@host:5432/mentoria"

# Auth.js — chave usada para assinar sessões/JWT. Gere a sua com:
# openssl rand -base64 32
AUTH_SECRET=""

# Conta do profissional (dono) criada pelo script de seed.
PROFESSIONAL_NAME="Seu Nome"
PROFESSIONAL_EMAIL="voce@example.com"
PROFESSIONAL_PASSWORD="escolha-uma-senha-forte"
